# ============================================================
#  Environment variables for the vendor application backend.
#  Copy to Vercel → Project → Settings → Environment Variables.
#  Everything here is OPTIONAL — with none set, the form falls
#  back to a client-side "download PDF + open email" flow.
# ============================================================

# ---- Email delivery (Resend — https://resend.com) ----
RESEND_API_KEY=
# Must be a verified sender/domain in Resend:
MAIL_FROM="Warthen RV Park <vendors@yourdomain.com>"
# Where completed applications are sent (defaults to the value below):
ADMIN_EMAIL=sisterrosellc@gmail.com

# ---- Database storage (Supabase — optional) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE=vendor_applications
